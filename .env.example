# Скопируйте этот файл в .env:  cp .env.example .env
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/library_catalog
DATABASE_POOL_SIZE=20
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_TIMEOUT=10
# Списки задаются в формате JSON:
CORS_ORIGINS=["*"]
